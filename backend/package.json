{
  "name": "belajar-vibe-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "start": "bun run dist/index.js",
    "db:generate": "drizzle-kit generate:mysql",
    "db:push": "drizzle-kit push:mysql"
  },
  "dependencies": {
    "elysia": "latest",
    "drizzle-orm": "latest",
    "mysql2": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "latest",
    "bun-types": "latest"
  }
}
